# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
# Sites allowed to call the API; comma-separate several (no trailing slashes).
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
# Keep this as "taxwise": schema.sql creates and uses that name.
DB_NAME=taxwise

# Only for a hosted database that needs TLS (e.g. Aiven): turn SSL on and paste
# the provider's CA certificate (the whole -----BEGIN CERTIFICATE----- block).
# DB_SSL=true
# DB_SSL_CA=

# Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1d
